  "version": "1.0.0",
  "description": "T-World Mini API – Learning + Profiles backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts' --fix",
    "test": "jest --runInBand --forceExit",
